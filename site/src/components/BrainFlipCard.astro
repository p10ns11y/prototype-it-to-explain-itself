---
import type { NnBrainMapping } from '../lib/nn-brain-map';

interface Props {
  mapping: NnBrainMapping;
}

const { mapping } = Astro.props;
---

<article class="brain-flip-card" data-flip-card>
  <button
    type="button"
    class="brain-flip-card__trigger"
    aria-label={`Flip card: ${mapping.nnTitle} ↔ ${mapping.brainTitle}`}
    data-flip-trigger
  >
    <div class="brain-flip-card__inner" data-flip-inner>
      <div class="brain-flip-card__face brain-flip-card__face--nn">
        <span class="brain-flip-card__badge">Neural network</span>
        <h3 class="brain-flip-card__title">{mapping.nnTitle}</h3>
        <p class="brain-flip-card__detail">{mapping.nnDetail}</p>
        <span class="brain-flip-card__hint">Tap to see the analogy side →</span>
      </div>

      <div class="brain-flip-card__face brain-flip-card__face--brain">
        <span class="brain-flip-card__badge brain-flip-card__badge--brain">Teaching analogy</span>
        <h3 class="brain-flip-card__title">{mapping.brainTitle}</h3>
        <p class="brain-flip-card__detail">{mapping.brainDetail}</p>
        <span class="brain-flip-card__hint">Tap to see the network side →</span>
      </div>
    </div>
  </button>

  {
    mapping.links.length > 0 && (
      <div class="brain-flip-card__links">
        {mapping.links.map((link) => (
          <a href={link.href} class="brain-flip-card__link">{link.label}</a>
        ))}
      </div>
    )
  }
</article>

<style>
  .brain-flip-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .brain-flip-card__trigger {
    all: unset;
    cursor: pointer;
    display: block;
    perspective: 1000px;
    width: 100%;
  }

  .brain-flip-card__trigger:focus-visible {
    outline: 2px solid #a1a1aa;
    outline-offset: 4px;
    border-radius: 1.5rem;
  }

  .brain-flip-card__inner {
    position: relative;
    min-height: 11rem;
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
  }

  .brain-flip-card.is-flipped .brain-flip-card__inner {
    transform: rotateY(180deg);
  }

  .brain-flip-card__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 1.5rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .brain-flip-card__face--brain {
    transform: rotateY(180deg);
    background: #fafafa;
    border-color: #d4d4d8;
  }

  .brain-flip-card__badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #52525b;
    background: #f4f4f5;
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
    margin-bottom: 0.75rem;
  }

  .brain-flip-card__badge--brain {
    color: #3f3f46;
    background: #e4e4e7;
  }

  .brain-flip-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #18181b;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .brain-flip-card__detail {
    font-size: 0.875rem;
    color: #52525b;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .brain-flip-card__hint {
    font-size: 0.75rem;
    color: #a1a1aa;
    margin-top: 0.75rem;
  }

  .brain-flip-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-left: 0.25rem;
  }

  .brain-flip-card__link {
    font-size: 0.8rem;
    font-weight: 500;
    color: #3f3f46;
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    background: #ffffff;
    border: 1px solid #d4d4d8;
    border-radius: 9999px;
    transition: border-color 0.15s, background-color 0.15s;
  }

  .brain-flip-card__link:hover {
    background: #f4f4f5;
    border-color: #a1a1aa;
    color: #18181b;
  }
</style>

<script>
  function initFlipCards() {
    document.querySelectorAll<HTMLElement>('[data-flip-card]').forEach((card) => {
      const trigger = card.querySelector<HTMLButtonElement>('[data-flip-trigger]');
      if (!trigger || trigger.dataset.flipBound === 'true') return;
      trigger.dataset.flipBound = 'true';

      trigger.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) return;
        card.classList.toggle('is-flipped');
      });
    });
  }

  initFlipCards();
  document.addEventListener('astro:page-load', initFlipCards);
</script>
